{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LabInvoiceSystem",
  "version": "3.0.0",
  "identifier": "dev.migo.labinvoicesystem",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LabInvoiceSystem",
        "width": 1280,
        "height": 850,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "backgroundColor": "#0f172a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) 2026 MIGO-OvO",
    "category": "Productivity",
    "shortDescription": "实验室发票整理与团队报账工作台",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0RUNFRTNERDJEMjY1NjQKUldSa1pkTFNQZTdzQk1aNWxKb2lxcmxYRlZ1SUpsR0ZrTFg1c0RYWWxyVWdLWnVhWGc2SW1aNEwK",
      "endpoints": [
        "https://github.com/MIGO-OvO/LabInvoiceSystem/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
