<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LabInvoiceSystem.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="LabInvoiceSystem.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/genshin_impact.ico"
        Title="LabInvoiceSystem"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        ExtendClientAreaToDecorationsHint="True">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <Border IsHitTestVisible="False" Background="{DynamicResource AppBackgroundBrush}" />

        <SplitView IsPaneOpen="{Binding IsPaneOpen}"
                   DisplayMode="CompactInline"
                   OpenPaneLength="192"
                   CompactPaneLength="0"
                   PaneBackground="{DynamicResource CardBackgroundBrush}"
                   Background="Transparent">

                    <SplitView.Pane>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid RowDefinitions="Auto,*,Auto" Margin="0,30,0,0" MinHeight="400">
                                <!-- Logo Area -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="16,16,16,24">
                                    <Border Width="32" Height="32" CornerRadius="8">
                                        <svg:Svg Path="/Assets/genshin_impact.svg"
                                                 Stretch="Uniform"
                                                 Width="32" Height="32"/>
                                    </Border>
                                    <TextBlock Text="发票助手" 
                                               FontSize="18" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Navigation -->
                                <StackPanel Grid.Row="1" Spacing="4" Margin="8,0">
                                    <Button Classes="NavButton" 
                                            Command="{Binding NavigateCommand}" 
                                            CommandParameter="Import"
                                            Classes.Active="{Binding CurrentViewName, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Import}">
                                        <StackPanel Orientation="Horizontal">
                                            <PathIcon Data="{StaticResource IconImport}"/>
                                            <TextBlock Text="发票录入"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button Classes="NavButton" 
                                            Command="{Binding NavigateCommand}" 
                                            CommandParameter="Export"
                                            Classes.Active="{Binding CurrentViewName, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Export}">
                                        <StackPanel Orientation="Horizontal">
                                            <PathIcon Data="{StaticResource IconExport}"/>
                                            <TextBlock Text="发票导出"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button Classes="NavButton" 
                                            Command="{Binding NavigateCommand}" 
                                            CommandParameter="Statistics"
                                            Classes.Active="{Binding CurrentViewName, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Statistics}">
                                        <StackPanel Orientation="Horizontal">
                                            <PathIcon Data="{StaticResource IconStatistics}"/>
                                            <TextBlock Text="仪表盘"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Bottom Actions -->
                                <Border Grid.Row="2" 
                                        BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="0,1,0,0" 
                                        Padding="16,12" 
                                        Margin="0,0,0,16">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Version 2.0.0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="Powered by Baidu OCR" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
                                        </StackPanel>
                                        
                                        <Button Grid.Column="1" 
                                                Command="{Binding ToggleThemeCommand}"
                                                Theme="{DynamicResource TransparentButton}"
                                                AutomationProperties.Name="切换明暗主题"
                                                ToolTip.Tip="切换明暗主题"
                                                Padding="6">
                                            <PathIcon Data="{StaticResource IconTheme}" 
                                                      Width="16" Height="16"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </SplitView.Pane>

                    <SplitView.Content>
                        <Grid RowDefinitions="Auto,*">
                            <!-- Top Bar (Hamburger) -->
                            <Grid Grid.Row="0" Height="44" Background="Transparent" Margin="12,6" PointerPressed="TitleBar_OnPointerPressed">
                                <Button Command="{Binding TriggerPaneCommand}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Theme="{DynamicResource TransparentButton}"
                                        AutomationProperties.Name="打开导航栏"
                                        IsVisible="{Binding !IsPaneOpen}">
                                    <PathIcon Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" 
                                              Width="18" Height="18"
                                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Button>
                            </Grid>

                            <!-- View Content Container -->
                            <Border Grid.Row="1" Padding="20,0,20,20">
                                <TransitioningContentControl Content="{Binding CurrentView}"
                                                             x:Name="ContentArea">
                                    <TransitioningContentControl.PageTransition>
                                        <CrossFade Duration="0:0:0.15" />
                                    </TransitioningContentControl.PageTransition>
                                </TransitioningContentControl>
                            </Border>
                        </Grid>
                    </SplitView.Content>
                </SplitView>

        <Border Background="#99000000"
                IsVisible="{Binding IsExitConfirmationOpen}">
            <Border Classes="Card"
                    Width="420"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="还有未归档的发票" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="现在退出会丢弃本次 OCR 和人工修改。原始文件不会受影响。"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button x:Name="ContinueWorkButton"
                                Classes="Primary"
                                Click="OnContinueWorkClick"
                                Content="继续处理"/>
                        <Button Classes="Danger"
                                Click="OnDiscardAndExitClick"
                                Content="退出并丢弃"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border Classes="Card"
                IsVisible="{Binding HasShellMessage}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="20"
                Padding="12,8"
                AutomationProperties.LiveSetting="Assertive">
            <TextBlock Text="{Binding ShellMessage}" TextWrapping="Wrap" MaxWidth="360"/>
        </Border>
    </Panel>
</Window>
