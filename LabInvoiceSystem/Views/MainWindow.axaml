<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LabInvoiceSystem.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="LabInvoiceSystem.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/genshin_impact.ico"
        Title="LabInvoiceSystem"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <!-- Background Gradient/Tint -->
        <Border IsHitTestVisible="False" Background="{DynamicResource AppBackgroundBrush}" />

        <!-- 整体缩放容器 - 包含导航栏和内容区域 -->
        <Viewbox Stretch="Uniform" 
                 StretchDirection="Both"
                 x:Name="MainViewbox">
            <Border x:Name="ViewboxContent" 
                    Width="1280" 
                    Height="800">
                <!-- Main Layout -->
                <SplitView IsPaneOpen="{Binding IsPaneOpen}"
                           DisplayMode="CompactInline"
                           OpenPaneLength="180"
                           CompactPaneLength="0"
                           PaneBackground="{DynamicResource CardBackgroundBrush}"
                           Background="Transparent">

                    <SplitView.Pane>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid RowDefinitions="Auto,*,Auto" Margin="0,30,0,0" MinHeight="400">
                                <!-- Logo Area -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="16,16,16,24">
                                    <Border Width="32" Height="32" CornerRadius="8">
                                        <svg:Svg Path="/Assets/genshin_impact.svg"
                                                 Stretch="Uniform"
                                                 Width="32" Height="32"/>
                                    </Border>
                                    <TextBlock Text="发票助手" 
                                               FontSize="18" 
                                               FontWeight="Bold" 
                                               VerticalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                <GradientStop Offset="0" Color="{DynamicResource Indigo500}"/>
                                                <GradientStop Offset="1" Color="#c084fc"/>
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Navigation -->
                                <StackPanel Grid.Row="1" Spacing="4" Margin="8,0">
                                    <Button Classes="NavButton" 
                                            Command="{Binding NavigateCommand}" 
                                            CommandParameter="Import"
                                            Classes.Active="{Binding CurrentViewName, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Import}">
                                        <StackPanel Orientation="Horizontal">
                                            <PathIcon Data="{StaticResource IconImport}"/>
                                            <TextBlock Text="发票录入"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button Classes="NavButton" 
                                            Command="{Binding NavigateCommand}" 
                                            CommandParameter="Export"
                                            Classes.Active="{Binding CurrentViewName, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Export}">
                                        <StackPanel Orientation="Horizontal">
                                            <PathIcon Data="{StaticResource IconExport}"/>
                                            <TextBlock Text="发票导出"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button Classes="NavButton" 
                                            Command="{Binding NavigateCommand}" 
                                            CommandParameter="Statistics"
                                            Classes.Active="{Binding CurrentViewName, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Statistics}">
                                        <StackPanel Orientation="Horizontal">
                                            <PathIcon Data="{StaticResource IconStatistics}"/>
                                            <TextBlock Text="仪表盘"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Bottom Actions -->
                                <Border Grid.Row="2" 
                                        BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="0,1,0,0" 
                                        Padding="16,12" 
                                        Margin="0,0,0,16">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Version 1.0.0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="Powered by Baidu OCR" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
                                        </StackPanel>
                                        
                                        <Button Grid.Column="1" 
                                                Command="{Binding ToggleThemeCommand}"
                                                Theme="{DynamicResource TransparentButton}"
                                                Padding="6">
                                            <PathIcon Data="{StaticResource IconTheme}" 
                                                      Width="16" Height="16"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </SplitView.Pane>

                    <SplitView.Content>
                        <Grid RowDefinitions="Auto,*">
                            <!-- Top Bar (Hamburger) -->
                            <Grid Grid.Row="0" Height="44" Background="Transparent" Margin="12,6" PointerPressed="TitleBar_OnPointerPressed">
                                <Button Command="{Binding TriggerPaneCommand}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Theme="{DynamicResource TransparentButton}"
                                        IsVisible="{Binding !IsPaneOpen}">
                                    <PathIcon Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" 
                                              Width="18" Height="18"
                                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Button>
                            </Grid>

                            <!-- View Content Container -->
                            <Border Grid.Row="1" Padding="20,0,20,20">
                                <TransitioningContentControl Content="{Binding CurrentView}"
                                                             x:Name="ContentArea">
                                    <TransitioningContentControl.PageTransition>
                                        <CrossFade Duration="0:0:0.3" />
                                    </TransitioningContentControl.PageTransition>
                                </TransitioningContentControl>
                            </Border>
                        </Grid>
                    </SplitView.Content>
                </SplitView>
            </Border>
        </Viewbox>
    </Panel>
</Window>
