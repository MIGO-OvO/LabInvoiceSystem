<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LabInvoiceSystem.ViewModels"
             xmlns:converters="using:LabInvoiceSystem.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="LabInvoiceSystem.Views.InvoiceImportView"
             x:DataType="vm:InvoiceImportViewModel">

    <UserControl.Resources>
        <converters:BytesToImageConverter x:Key="BytesToImage"/>
        <converters:InvoiceStatusToColorConverter x:Key="StatusToColor"/>
        <converters:InvoiceStatusToTextConverter x:Key="StatusToText"/>
        <converters:InvoiceStatusToIconConverter x:Key="StatusToIcon"/>
        <converters:DateTimeToDateTimeOffsetConverter x:Key="DateTimeToDateTimeOffset"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- Top Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
            <TextBlock Text="发票录入" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            
            <WrapPanel Grid.Column="2" HorizontalAlignment="Right">
                <!-- 统一日期选择器 -->
                <Border VerticalAlignment="Center" 
                        IsVisible="{Binding UploadedInvoices.Count}">
                    <DatePicker SelectedDate="{Binding UniformUploadDate}" 
                                HorizontalAlignment="Stretch"/>
                </Border>
                
                <Button Command="{Binding SetUniformDateCommand}"
                        Classes="Primary"
                        Padding="14,8"
                        IsVisible="{Binding UploadedInvoices.Count}"
                        IsEnabled="{Binding !IsProcessing}"
                        Margin="8,0,0,0">
                    <TextBlock Text="统一购买日期" FontWeight="SemiBold"/>
                </Button>
                
                <Button Command="{Binding ArchiveAllCommand}"
                        Classes="Success"
                        Padding="14,8"
                        IsVisible="{Binding UploadedInvoices.Count}"
                        IsEnabled="{Binding !IsProcessing}"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconArchive}" Width="16" Height="16"/>
                        <TextBlock Text="全部归档"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding UploadFilesCommand}"
                        Classes="Primary"
                        HotKey="Ctrl+O"
                        IsEnabled="{Binding !IsProcessing}"
                        AutomationProperties.Name="上传发票文件"
                        Margin="8,0,0,0"
                        Padding="14,8">
                    <TextBlock Text="上传文件"/>
                </Button>
            </WrapPanel>
        </Grid>

        <Border Grid.Row="1"
                Classes="Card"
                Padding="14"
                Margin="0,0,0,12"
                BorderBrush="{DynamicResource PrimaryBrush}"
                IsVisible="{Binding IsCloudOcrNoticeVisible}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="使用百度云 OCR 前请确认" FontWeight="SemiBold"/>
                    <TextBlock Text="识别时会把发票图像上传至百度云。你也可以只在本机手工录入，原文件不会上传。"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="Primary"
                            Command="{Binding AcceptCloudOcrNoticeCommand}"
                            Content="同意并启用云端 OCR"/>
                    <Button Classes="Capsule"
                            Command="{Binding UseManualEntryCommand}"
                            Content="仅手工录入"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Classes="Card" Padding="10" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusMessage}"
                           AutomationProperties.LiveSetting="Polite"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1"
                        Command="{Binding CancelProcessingCommand}"
                        IsVisible="{Binding IsProcessing}"
                        Classes="Danger"
                        Padding="10,6">
                    <TextBlock Text="取消处理"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main Split Layout - 使用比例布局 -->
        <Grid x:Name="MainSplitGrid" Grid.Row="3" ColumnDefinitions="2*,16,3*">
        
            <!-- Left Pane: File List & Drop Zone -->
            <Grid x:Name="LeftPane" Grid.Column="0" RowDefinitions="Auto,*"
                  DragDrop.AllowDrop="True"
                  DragDrop.Drop="OnDrop">
                <!-- Drop Zone (Visible when empty) -->
                <Button Grid.Row="0" Grid.RowSpan="2"
                        Command="{Binding UploadFilesCommand}"
                        IsVisible="{Binding !UploadedInvoices.Count}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource BorderBrush}"
                        CornerRadius="12"
                        AutomationProperties.Name="上传或拖入发票文件"
                        Classes="Card">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource NavHoverBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Style>
                    </Button.Styles>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Border Width="60" Height="60" CornerRadius="30" Background="{DynamicResource Slate100}">
                            <PathIcon Data="{StaticResource IconImport}" Width="28" Height="28" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                        <TextBlock Text="拖拽发票到此处" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="支持 PDF, JPG, PNG" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- File List -->
                <ScrollViewer Grid.Row="1" IsVisible="{Binding UploadedInvoices.Count}">
                    <ItemsControl ItemsSource="{Binding UploadedInvoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding $parent[UserControl].((vm:InvoiceImportViewModel)DataContext).SelectInvoiceCommand}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,0,0,8"
                                        CornerRadius="12"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch">
                                    <Border CornerRadius="12" ClipToBounds="True">
                                        <Border Classes="Card" Padding="12" Cursor="Hand">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <!-- Status Icon -->
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0"
                                                        Background="{DynamicResource NavHoverBackgroundBrush}">
                                                    <Viewbox Width="16" Height="16"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center">
                                                        <Path Data="{Binding Status, Converter={StaticResource StatusToIcon}}"
                                                              Fill="{Binding Status, Converter={StaticResource StatusToColor}}"
                                                              Width="24" Height="24"
                                                              Stretch="Uniform"/>
                                                    </Viewbox>
                                                </Border>
                                                
                                                <!-- Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                     <TextBlock Text="{Binding Status, Converter={StaticResource StatusToText}}"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                                Margin="0,2,0,0"/>
                                                     <TextBlock Text="{Binding ProcessingMessage}"
                                                                IsVisible="{Binding HasProcessingMessage}"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                                TextTrimming="CharacterEllipsis"/>
                                                     <TextBlock Text="{Binding ErrorMessage}"
                                                                IsVisible="{Binding HasErrorMessage}"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource Red500}"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTip.Tip="{Binding ErrorMessage}"/>
                                                 </StackPanel>

                                                 <!-- Delete Action -->
                                                 <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                     <Button Classes="Primary"
                                                             Theme="{DynamicResource TransparentButton}"
                                                             Padding="10"
                                                             MinWidth="44"
                                                             MinHeight="44"
                                                             IsVisible="{Binding CanRetryOcr}"
                                                             Command="{Binding $parent[UserControl].((vm:InvoiceImportViewModel)DataContext).RetryOcrCommand}"
                                                     CommandParameter="{Binding}"
                                                     AutomationProperties.Name="重试 OCR"
                                                     ToolTip.Tip="重试 OCR">
                                                         <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Width="18" Height="18" Foreground="{DynamicResource PrimaryBrush}"/>
                                                     </Button>
                                                     <Button
                                                         Classes="Danger"
                                                         Theme="{DynamicResource TransparentButton}"
                                                         Padding="10"
                                                        MinWidth="44"
                                                        MinHeight="44"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding $parent[UserControl].((vm:InvoiceImportViewModel)DataContext).DeleteInvoiceCommand}"
                                                         CommandParameter="{Binding}"
                                                         AutomationProperties.Name="从待处理列表删除发票"
                                                         ToolTip.Tip="删除此发票">
                                                         <PathIcon Data="{StaticResource IconDelete}" Width="18" Height="18" Foreground="White"/>
                                                     </Button>
                                                 </StackPanel>
                                             </Grid>
                                        </Border>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Right Pane: Preview & Edit -->
            <Grid x:Name="RightPane" Grid.Column="2" RowDefinitions="*,Auto" IsVisible="{Binding SelectedInvoice, Converter={x:Static ObjectConverters.IsNotNull}}">
                
                <!-- Preview Area with Zoom Controls -->
                <Border Grid.Row="0" Classes="Card" Margin="0,0,0,16" Padding="0" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Zoom Control Bar -->
                        <Border Grid.Row="0" 
                                Background="{DynamicResource CardBackgroundBrush}" 
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="8,4"
                                IsVisible="{Binding PreviewImageBytes, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <Button Theme="{DynamicResource TransparentButton}" 
                                        Padding="6" 
                                        AutomationProperties.Name="缩小发票预览"
                                        ToolTip.Tip="缩小"
                                        Click="OnZoomOutClick">
                                    <PathIcon Data="M19,13H5V11H19V13Z" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <Button Theme="{DynamicResource TransparentButton}" 
                                        Padding="6" 
                                        AutomationProperties.Name="让发票预览适应窗口"
                                        ToolTip.Tip="适应窗口 (双击图片)"
                                        Click="OnFitToWindowClick">
                                    <PathIcon Data="M5,5H10V7H7V10H5V5M14,5H19V10H17V7H14V5M17,14H19V19H14V17H17V14M10,17V19H5V14H7V17H10Z" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <Button Theme="{DynamicResource TransparentButton}" 
                                        Padding="6" 
                                        AutomationProperties.Name="放大发票预览"
                                        ToolTip.Tip="放大"
                                        Click="OnZoomInClick">
                                    <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <TextBlock Text="滚轮缩放 | 拖动平移 | 双击重置" 
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Preview Image Container -->
                        <Border Grid.Row="1" 
                                x:Name="PreviewContainer"
                                Background="Transparent"
                                ClipToBounds="True"
                                PointerWheelChanged="OnPreviewPointerWheelChanged"
                                PointerPressed="OnPreviewPointerPressed"
                                PointerMoved="OnPreviewPointerMoved"
                                PointerReleased="OnPreviewPointerReleased"
                                DoubleTapped="OnPreviewDoubleTapped">
                            <Grid>
                                <TextBlock Text="暂无预览" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" 
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           IsVisible="{Binding PreviewImageBytes, Converter={x:Static ObjectConverters.IsNull}}"/>
                                
                                <!-- Zoomable/Pannable Image -->
                                <Image x:Name="PreviewImage"
                                       Source="{Binding PreviewImageBytes, Converter={StaticResource BytesToImage}}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5"
                                       IsVisible="{Binding PreviewImageBytes, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform X="0" Y="0"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Edit Form -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Classes="Card" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="确认信息" FontSize="16" FontWeight="Bold"/>

                            <Grid ColumnDefinitions="*,12,*">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="购买日期" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <DatePicker SelectedDate="{Binding SelectedInvoice.InvoiceDate, Converter={StaticResource DateTimeToDateTimeOffset}}"
                                                AutomationProperties.Name="购买日期"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="金额 (¥)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding SelectedInvoice.Amount}"
                                             AutomationProperties.Name="发票金额"/>
                                    <TextBlock Text="{Binding SelectedInvoice.AmountError}"
                                               IsVisible="{Binding SelectedInvoice.HasAmountError}"
                                               FontSize="11"
                                               Foreground="{DynamicResource DangerBrush}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Text="项目名称" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding SelectedInvoice.ItemName}"
                                         AutomationProperties.Name="项目名称"/>
                                <TextBlock Text="{Binding SelectedInvoice.ItemNameError}"
                                           IsVisible="{Binding SelectedInvoice.HasItemNameError}"
                                           FontSize="11"
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,12,*">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="发票号码" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding SelectedInvoice.InvoiceNumber}"
                                             AutomationProperties.Name="发票号码"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="销售方名称" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding SelectedInvoice.SellerName}"
                                             AutomationProperties.Name="销售方名称"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Text="销售方税号" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding SelectedInvoice.SellerTaxId}"
                                         AutomationProperties.Name="销售方税号"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="支付方式" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Grid ColumnDefinitions="*,8,*,8,*">
                                    <Button Grid.Column="0" 
                                            Classes="Capsule"
                                            Content="公务卡"
                                            Padding="10,6"
                                            Command="{Binding SetPaymentMethodCommand}"
                                            CommandParameter="公务卡"
                                            Classes.Active="{Binding SelectedInvoice.PaymentMethod, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=公务卡}"/>
                                    <Button Grid.Column="2" 
                                            Classes="Capsule"
                                            Content="现金"
                                            Padding="10,6"
                                            Command="{Binding SetPaymentMethodCommand}"
                                            CommandParameter="现金"
                                            Classes.Active="{Binding SelectedInvoice.PaymentMethod, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=现金}"/>
                                    <Button Grid.Column="4" 
                                            Classes="Capsule"
                                            Content="对公转账"
                                            Padding="10,6"
                                            Command="{Binding SetPaymentMethodCommand}"
                                            CommandParameter="对公转账"
                                            Classes.Active="{Binding SelectedInvoice.PaymentMethod, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=对公转账}"/>
                                </Grid>
                            </StackPanel>

                            <Border Classes="Card"
                                    Padding="12"
                                    BorderBrush="{DynamicResource DangerBrush}"
                                    IsVisible="{Binding SelectedInvoice.HasDuplicateWarning}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding SelectedInvoice.DuplicateWarning}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource DangerBrush}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                        <Button Classes="Capsule"
                                                Command="{Binding CancelDuplicateCommand}"
                                                CommandParameter="{Binding SelectedInvoice}"
                                                Content="返回核对"/>
                                        <Button Classes="Danger"
                                                Command="{Binding ArchiveDuplicateCommand}"
                                                CommandParameter="{Binding SelectedInvoice}"
                                                Content="仍然归档"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button Classes="Primary"
                                    Command="{Binding ArchiveSingleCommand}"
                                    CommandParameter="{Binding SelectedInvoice}"
                                    HotKey="Ctrl+Enter"
                                    IsEnabled="{Binding !IsProcessing}"
                                    IsVisible="{Binding !SelectedInvoice.HasDuplicateWarning}"
                                    HorizontalAlignment="Stretch" 
                                    HorizontalContentAlignment="Center"
                                    Padding="14,10">
                                <TextBlock Text="确认并归档" FontWeight="Bold"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
            
            <!-- Empty State for Right Pane -->
            <Grid x:Name="RightEmpty" Grid.Column="2" IsVisible="{Binding SelectedInvoice, Converter={x:Static ObjectConverters.IsNull}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <PathIcon Data="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" 
                              Width="48" Height="48" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="选择文件查看详情" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
